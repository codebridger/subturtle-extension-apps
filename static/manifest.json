{
	"name": "Subturtle: Learn English with Subtitles, Videos & AI Coach",
	"description": "Learn English from any video or page: save words, talk to an AI coach. Also Spanish, German, French, Italian, Swedish, Lithuanian.",
	"version": "1.17.0.4",
	"manifest_version": 3,
	"icons": {
		"128": "/assets/logo-128.png",
		"256": "/assets/logo-240.png"
	},
	"permissions": [
		"activeTab",
		"tabs",
		"storage",
		"identity"
	],
	"host_permissions": [
		"<all_urls>",
		"https://api-js.mixpanel.com/"
	],
	"oauth2": {
		"client_id": "245138511605-cg62vajjtrivc6deski1reb6hns4dqfa.apps.googleusercontent.com",
		"scopes": [
			"https://www.googleapis.com/auth/userinfo.email"
		]
	},
	"action": {
		"default_popup": "popup.html"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"https://www.netflix.com/*"
			],
			"js": [
				"main.js"
			]
		},
		{
			"matches": [
				"https://www.youtube.com/*"
			],
			"css": [
				"/assets/style/youtube.css"
			],
			"js": [
				"main.js"
			]
		},
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"nibble.js"
			]
		},
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"console-crane.js"
			]
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"assets/*"
			],
			"matches": [
				"<all_urls>"
			]
		}
	],
	"version_name": "1.17.0-dev.4"
}
